[Unit]
Description=RecursiveOps background worker
After=network.target

[Service]
Type=simple
User=recursiveops
Group=recursiveops
WorkingDirectory=/opt/recursiveops/backend
Environment=RECURSIVEOPS_CONFIG=/etc/recursiveops/config.yml
ExecStart=/opt/recursiveops/backend/.venv/bin/python -m recursiveops.jobs.scheduler
Restart=on-failure

[Install]
WantedBy=multi-user.target
